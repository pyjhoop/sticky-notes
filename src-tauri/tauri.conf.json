{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sticky Notes",
  "version": "1.0.0",
  "identifier": "com.sticky-notes.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "note",
        "title": "스티커 메모",
        "url": "index.html?w=note",
        "create": false,
        "visible": false,
        "width": 436,
        "height": 420,
        "minWidth": 240,
        "minHeight": 160,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "focus": true,
        "center": true,
        "dragDropEnabled": false
      },
      {
        "label": "board",
        "title": "모든 메모",
        "url": "index.html?w=board",
        "create": false,
        "visible": false,
        "width": 940,
        "height": 452,
        "minWidth": 640,
        "minHeight": 360,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "focus": true,
        "center": true,
        "dragDropEnabled": false
      },
      {
        "label": "settings",
        "title": "설정",
        "url": "index.html?w=settings",
        "create": false,
        "visible": false,
        "width": 620,
        "height": 640,
        "minWidth": 620,
        "maxWidth": 620,
        "minHeight": 480,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "maximizable": false,
        "minimizable": true,
        "focus": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/pyjhoop/sticky-notes/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCQzRDNDgxMzU2NDFGNzMKUldSekgyUTFnY1RFVzdrc2s2UVFmaUNsYnR4aVFZekU0RlpXVlBZR254dTJUQjJBQWZlMVM1MWEK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"]
      }
    }
  }
}
